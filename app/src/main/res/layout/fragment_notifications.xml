<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp"
    tools:context=".ui.notifications.NotificationsFragment">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/title_notifications"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Notificações"
        android:textColor="@color/primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CARD -->
    <LinearLayout
        android:id="@+id/notificationCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/image_border"
        android:padding="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/title_notifications"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lembretes ativos"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/text_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhuma notificação no momento."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/testNotificationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testar notificação"
            android:textColor="#000000"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>