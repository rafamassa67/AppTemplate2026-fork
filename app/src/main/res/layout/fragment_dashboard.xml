<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/text_dashboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cadastro de administrador"
        android:textAlignment="center"
        android:textColor="@color/primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- IMAGEM -->
    <ImageView
        android:id="@+id/image_item"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/image_border"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_camera"
        app:layout_constraintTop_toBottomOf="@id/text_dashboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÃO IMAGEM -->
    <Button
        android:id="@+id/button_select_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecionar Imagem"
        android:textColor="#000000"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/image_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CAIXA DO TIPO -->
    <LinearLayout
        android:id="@+id/tipoBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/image_border"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/button_select_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo do administrador"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_gravity="center"/>

        <RadioGroup
            android:id="@+id/tipoGrupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioLimitador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limitador"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/radioLembrete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lembrete"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layout_marginStart="24dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- NOME -->
    <EditText
        android:id="@+id/nomeRelogio"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Nomeie o seu administrador"
        android:background="@drawable/input_bg_white"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:padding="14dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tipoBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TEMPO -->
    <EditText
        android:id="@+id/tempoAdministrador"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Tempo limite (em minutos)"
        android:inputType="number"
        android:background="@drawable/input_bg_white"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/nomeRelogio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- DESCRIÇÃO -->
    <EditText
        android:id="@+id/adminDescription"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Descrição"
        android:background="@drawable/input_bg_white"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tempoAdministrador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÃO SALVAR -->
    <Button
        android:id="@+id/salvarItemButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Salvar"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/adminDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>